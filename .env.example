# HMAC-SHA256 secret for normalized POST /api/shop/payment-callback payloads.
# Sign the exact JSON body and send it in X-AirText-Payment-Signature.
# Body: {"reference_id":"AIR_...","status":"paid"} or {"status":"failed"}.
SHOP_WEBHOOK_SECRET=

# Payment provider credentials. Use the provider's API base URL and server-side token.
AZAMPAY_BASE_URL=
AZAMPAY_TOKEN=
SELCOM_BASE_URL=
SELCOM_API_KEY=
SELCOM_API_SECRET=
SELCOM_VENDOR=

APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=airtext
# Create a dedicated MySQL user for the app and set its password here.
DB_USERNAME=airtext_app
DB_PASSWORD=

# Point this to a trusted self-hosted LibreTranslate instance. No key is needed
# when the instance is configured without authentication.
AIRTEXT_TRANSLATION_PROVIDER=libre
AIRTEXT_TRANSLATION_URL=http://127.0.0.1:5000/translate
AIRTEXT_TRANSLATION_KEY=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb

REVERB_APP_ID=airtext
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http

TURN_STUN_URLS=
TURN_URLS=
TURN_SHARED_SECRET=
TURN_CREDENTIAL_TTL=3600
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
